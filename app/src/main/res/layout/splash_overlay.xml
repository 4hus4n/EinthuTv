<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clickable="true"
    android:elevation="40dp"
    android:focusable="true">

    <View
        android:id="@+id/splashGlow"
        android:layout_width="640dp"
        android:layout_height="640dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/splash_glow" />

    <LinearLayout
        android:id="@+id/splashCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/splashLogo"
            android:layout_width="150dp"
            android:layout_height="190dp">

            <ImageView
                android:id="@+id/splashStrip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:contentDescription="@null"
                android:src="@drawable/splash_strip" />

            <ImageView
                android:id="@+id/splashPlay"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:layout_marginStart="6dp"
                android:alpha="0"
                android:contentDescription="@null"
                android:src="@drawable/splash_play" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/splashTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0"
            android:letterSpacing="0.08"
            android:text="@string/subtitle"
            android:textColor="#B3FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/splashTrack"
        android:layout_width="240dp"
        android:layout_height="4dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="86dp"
        android:alpha="0"
        android:background="@drawable/splash_track">

        <View
            android:id="@+id/splashBar"
            android:layout_width="80dp"
            android:layout_height="4dp"
            android:background="@drawable/splash_bar" />
    </FrameLayout>

    <TextView
        android:id="@+id/splashCredit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:alpha="0"
        android:text="@string/credit"
        android:textColor="#66FFFFFF"
        android:textSize="13sp" />
</FrameLayout>
