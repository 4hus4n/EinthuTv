<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <WebView
        android:id="@+id/loaderWebView"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:focusable="false" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Top bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@color/bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="40dp"
                android:paddingEnd="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.04"
                    android:text="@string/logo"
                    android:textColor="@color/accent"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <Button android:id="@+id/btnHome" style="@style/TopTab" android:text="@string/home_button" />
                <Button android:id="@+id/btnBrowse" style="@style/TopTab" android:text="@string/tab_browse" />
            </LinearLayout>

            <!-- Title + paging -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="40dp"
                android:paddingTop="20dp"
                android:paddingEnd="40dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/gridTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPrev"
                    style="@style/FilterButton"
                    android:minWidth="0dp"
                    android:gravity="center"
                    android:text="@string/prev" />

                <TextView
                    android:id="@+id/pageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:textColor="#B3FFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnNext"
                    style="@style/FilterButton"
                    android:layout_marginEnd="0dp"
                    android:minWidth="0dp"
                    android:gravity="center"
                    android:text="@string/next" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/btn_outline"
                android:focusable="true"
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingEnd="32dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
