<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Hidden page loader for the movie lists -->
    <WebView
        android:id="@+id/loaderWebView"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:focusable="false" />

    <!-- Hidden page used to check / perform sign-in -->
    <WebView
        android:id="@+id/authWebView"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:focusable="false" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Top bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@color/bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="40dp"
                android:paddingEnd="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="32dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.04"
                    android:text="@string/logo"
                    android:textColor="@color/accent"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <Button android:id="@+id/tabHome" style="@style/TopTab" android:text="@string/tab_home"
                    android:textColor="#FFFFFF" />
                <Button android:id="@+id/tabMovies" style="@style/TopTab" android:text="@string/tab_movies" />
                <Button android:id="@+id/tabBrowse" style="@style/TopTab" android:text="@string/tab_browse" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button android:id="@+id/tabUpdate" style="@style/TopTab" android:text="@string/tab_update" />
                <Button android:id="@+id/tabAccount" style="@style/TopTab" android:text="@string/tab_account" />
            </LinearLayout>

            <!-- Filters -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="40dp"
                android:paddingTop="16dp"
                android:paddingEnd="40dp"
                android:paddingBottom="16dp">

                <Button android:id="@+id/btnLang" style="@style/FilterButton" />
                <Button android:id="@+id/btnYear" style="@style/FilterButton" />
            </LinearLayout>

            <!-- Hero -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="330dp">

                <ImageView
                    android:id="@+id/heroBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.35"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/hero_fade" />

                <ImageView
                    android:id="@+id/heroPoster"
                    android:layout_width="180dp"
                    android:layout_height="260dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="64dp"
                    android:background="@drawable/poster_placeholder"
                    android:contentDescription="@null"
                    android:elevation="10dp"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/heroText"
                    android:layout_marginEnd="300dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="40dp">

                    <TextView
                        android:id="@+id/heroEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:letterSpacing="0.12"
                        android:textAllCaps="true"
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/heroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="serif"
                        android:maxLines="2"
                        android:textColor="#FFFFFF"
                        android:textSize="38sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/heroMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#E6FFFFFF"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/heroBadges"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:background="@drawable/badge_bg"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/heroDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="3dp"
                        android:maxLines="4"
                        android:textColor="#CCFFFFFF"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnPlay"
                            style="@style/PrimaryButton"
                            android:text="@string/play" />

                        <Button
                            android:id="@+id/btnSeeAll"
                            style="@style/OutlineButton"
                            android:text="@string/see_all" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/heroDots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_outline"
                android:focusable="true"
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
